# ==========================================
# 1. Google AI (Gemini 2.5 Flash)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. Database (SQLite local dev / Google Cloud SQL PostgreSQL in GCP)
# ==========================================
# Local dev:
DATABASE_URL=sqlite:///./vexa_bridge.db
# Cloud Run + Cloud SQL Unix Socket example:
# DATABASE_URL=postgresql+psycopg2://vexa_user:DB_PASSWORD@/vexa_bridge?host=/cloudsql/YOUR_PROJECT:asia-south1:vexa-pg

# ==========================================
# 3. Google Cloud Storage (Isolated Raw vs Masked Buckets)
# ==========================================
GCS_BUCKET_RAW=
GCS_BUCKET_MASKED=

# ==========================================
# 4. Authentication (Firebase Auth + JWT Session Signing)
# ==========================================
JWT_SECRET=change-this-to-a-long-random-secret
FIREBASE_PROJECT_ID=
# Path to Firebase service account JSON (or leave empty on Cloud Run to use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# Bootstrap Platform Admin account (created automatically on empty DB)
ADMIN_BOOTSTRAP_EMAIL=admin@vexabridge.in
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeAdmin2026!

# ==========================================
# 5. Frontend Firebase Web SDK (Vite Public Env Vars)
# ==========================================
VITE_API_BASE=/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
