# Google AI (Gemini 2.5 Flash via official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (SQLite for local dev; Cloud SQL PostgreSQL 15+ for production)
DATABASE_URL=sqlite:///./vexa_bridge.db

# Google Cloud Storage Buckets (leave empty to use local ./storage/raw and ./storage/masked fallback)
GCS_BUCKET_RAW=
GCS_BUCKET_MASKED=
